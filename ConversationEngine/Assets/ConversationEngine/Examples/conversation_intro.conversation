                "Functions": [],
                "conditionalBranch": {
                    "Conditions": [],
                    "NextNodeIdTrue": 0,
                    "NextNodeIdFalse": 0
                },
                "DefaultBranchNodeId": 0
            },
            {
                "Id": 6,
                "NodeType": "Dialogue",
                "Text": "Will you accept this mission and help us rescue her?",
                "Comment": "",
                "EditorPosition": {
                    "x": 100.0,
                    "y": 1393.635986328125
                },
                "EditorSize": {
                    "x": 200.0,
                    "y": 100.0
