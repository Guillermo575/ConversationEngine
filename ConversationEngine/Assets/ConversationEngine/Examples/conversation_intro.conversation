                        "Conditions": [],
                        "HideOption": false,
                        "BlockText": ""
                    },
                    {
                        "Id": 0,
                        "NodeType": "Option",
                        "Text": "Can you repeat that again?",
                        "Comment": "",
                        "EditorPosition": {
                            "x": 237.3343963623047,
