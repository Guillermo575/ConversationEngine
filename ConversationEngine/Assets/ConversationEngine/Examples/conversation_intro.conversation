        },
        "EditorSize": {
          "x": 200,
          "y": 100
        }
      },
      {
        "Id": 6,
        "NodeType": "Dialogue",
        "SpeakerActorId": "actor_2",
        "Text": "Will you accept this mission and help us rescue her?",
        "lstAlternateText": [
        ],
        "NextNodeId": 7,
        "Options": [
        ],
        "Functions": [
        ],
        "conditionalBranch": {},
