        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        }
      },
      {
        "Id": 4,
        "NodeType": 1,
        "SpeakerActorId": "actor_1",
        "Text": "Greetings, traveler. You look troubled. Is something wrong?",
        "NextNodeId": 5,
        "Options": [],
        "Functions": [],
        "ConditionalBranches": [],
        "DefaultBranchNodeId": 0,
        "EditorPosition": {
          "x": 660.0,
          "y": 0.0
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        }
      },
      {
        "Id": 5,
        "NodeType": 1,
        "SpeakerActorId": "actor_2",
        "Text": "I come from the royal court. The princess was taken at dawn by raiders from Blackstone Keep.",
        "NextNodeId": 6,
        "Options": [],
        "Functions": [],
        "ConditionalBranches": [],
        "DefaultBranchNodeId": 0,
        "EditorPosition": {
          "x": 900.0,
          "y": 0.0
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        }
      },
      {
        "Id": 6,
        "NodeType": 1,
        "SpeakerActorId": "actor_2",
        "Text": "Will you accept this mission and help us rescue her?",
        "NextNodeId": 7,
        "Options": [],
        "Functions": [],
        "ConditionalBranches": [],
        "DefaultBranchNodeId": 0,
        "EditorPosition": {
          "x": 1140.0,
          "y": 0.0
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        }
      },
      {
        "Id": 7,
        "NodeType": 1,
        "SpeakerActorId": "",
        "Text": "What do you want to do?",
        "NextNodeId": 0,
        "Options": [
          {
            "Text": "Yes",
            "NextNodeId": 8,
            "Conditions": []
          },
          {
            "Text": "Alright, but you will pay me double",
            "NextNodeId": 9,
            "Conditions": []
          },
          {
            "Text": "Can you repeat that again?",
            "NextNodeId": 5,
            "Conditions": []
          },
          {
            "Text": "No thanks",
            "NextNodeId": 10,
            "Conditions": []
          }
        ],
        "Functions": [],
        "ConditionalBranches": [],
        "DefaultBranchNodeId": 0,
        "EditorPosition": {
          "x": 1380.0,
