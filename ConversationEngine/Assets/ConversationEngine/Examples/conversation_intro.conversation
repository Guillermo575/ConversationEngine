            {
                "Id": 3,
                "NodeType": "Dialogue",
                "Text": "Many years ago, in a distant land, an old kingdom stood against the shadows.",
                "Comment": "",
                "EditorPosition": {
                    "x": 402.7272033691406,
                    "y": 877.982421875
                },
                "EditorSize": {
                    "x": 200.0,
                    "y": 93.125
