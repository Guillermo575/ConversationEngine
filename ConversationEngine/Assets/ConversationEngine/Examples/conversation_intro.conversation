      },
      {
        "Id": 3,
        "NodeType": 1,
        "SpeakerActorId": "",
        "Text": "Many years ago, in a distant land, an old kingdom stood against the shadows.",
        "NextNodeId": 4,
        "Options": [],
        "Functions": [],
        "ConditionalBranches": [],
        "DefaultBranchNodeId": 0,
        "EditorPosition": {
          "x": 420.0,
          "y": 0.0
