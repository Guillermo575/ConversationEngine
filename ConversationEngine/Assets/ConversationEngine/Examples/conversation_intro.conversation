                    "NextNodeIdFalse": 0
                },
                "DefaultBranchNodeId": 0
            },
            {
                "Id": 4,
                "NodeType": "Dialogue",
                "Text": "Greetings, traveler. You look troubled. Is something wrong?",
                "Comment": "",
                "EditorPosition": {
                    "x": 400.90899658203127,
                    "y": 1088.1820068359375
                },
                "EditorSize": {
                    "x": 200.0,
                    "y": 100.0
