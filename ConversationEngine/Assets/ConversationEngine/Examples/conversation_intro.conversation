          "x": 200,
          "y": 100
        }
      },
      {
        "Id": 7,
        "NodeType": "Dialogue",
        "SpeakerActorId": "",
        "Text": "What do you want to do?",
        "lstAlternateText": [
        ],
        "NextNodeId": 0,
