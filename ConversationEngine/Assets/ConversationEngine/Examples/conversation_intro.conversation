        "EditorSize": {
          "X": 200,
          "Y": 100
        }
      },
      {
        "Id": 6,
        "NodeType": "Dialogue",
        "SpeakerActorId": "actor_2",
        "Text": "Will you accept this mission and help us rescue her?",
        "NextNodeId": 7,
        "Options": [
        ],
        "Functions": [
        ],
        "conditionalBranch": {},
        "DefaultBranchNodeId": 0,
        "EditorPosition": {
