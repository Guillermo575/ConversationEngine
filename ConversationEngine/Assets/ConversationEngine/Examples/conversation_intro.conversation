      },
      {
        "Id": 7,
        "NodeType": "Dialogue",
        "SpeakerActorId": "",
        "Text": "What do you want to do?",
        "NextNodeId": 0,
        "Options": [
          {
            "Text": "Yes",
            "NextNodeId": 8,
            "EditorPosition": {
              "X": 230.9499,
              "Y": 6.806464
            },
            "EditorSize": {
              "X": 150,
              "Y": 60
            },
            "Conditions": []
          },
          {
            "Text": "Alright, but you will pay me double",
