          }
        ]
      },
      {
        "Id": 4,
        "NodeType": "Dialogue",
        "Text": "Greetings, traveler. You look troubled. Is something wrong?",
        "EditorPosition": {
          "x": 400.90899658203125,
          "y": 1088.1820068359375
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        },
        "SpeakerActorId": "actor_1",
        "NextNodeId": 5,
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 5,
        "NodeType": "Dialogue",
        "Text": "I come from the royal court. The princess was taken at dawn by raiders from Blackstone Keep.",
        "EditorPosition": {
          "x": 399.09078979492188,
          "y": 1298.1829833984375
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        },
        "SpeakerActorId": "actor_2",
        "NextNodeId": 6,
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 6,
        "NodeType": "Dialogue",
        "Text": "Will you accept this mission and help us rescue her?",
        "EditorPosition": {
          "x": 100.0,
          "y": 1393.635986328125
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        },
        "SpeakerActorId": "actor_2",
        "NextNodeId": 7,
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 7,
        "NodeType": "Dialogue",
        "Text": "What do you want to do?",
        "EditorPosition": {
          "x": 622.02862548828125,
          "y": 1647.800048828125
        },
        "EditorSize": {
          "x": 200.0,
          "y": 150.0
        },
        "NextNodeId": 0,
        "Options": [
          {
            "Id": 0,
            "NodeType": "Option",
            "Text": "Yes",
            "EditorPosition": {
              "x": 230.94990539550781,
              "y": 26.037229537963867
            },
            "EditorSize": {
              "x": 150.0,
              "y": 40.769290924072266
            },
            "NextNodeId": 8,
            "HideOption": false
          },
          {
            "Id": 0,
            "NodeType": "Option",
            "Text": "Alright, but you will pay me double",
            "EditorPosition": {
              "x": 492.89511108398438,
              "y": -23.596080780029297
            },
            "EditorSize": {
              "x": 150.0,
              "y": 60.0
            },
            "NextNodeId": 9,
            "HideOption": false
          },
          {
            "Id": 0,
            "NodeType": "Option",
            "Text": "Can you repeat that again?",
            "EditorPosition": {
              "x": 237.33439636230469,
              "y": 133.62409973144531
            },
            "EditorSize": {
              "x": 150.0,
              "y": 60.0
            },
            "NextNodeId": 5,
            "HideOption": false
          },
          {
            "Id": 0,
            "NodeType": "Option",
            "Text": "No thanks",
            "EditorPosition": {
              "x": 171.71919250488281,
              "y": 274.88299560546875
            },
            "EditorSize": {
              "x": 150.0,
              "y": 60.0
            },
            "NextNodeId": 10,
            "HideOption": false
          }
        ],
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 8,
        "NodeType": "Dialogue",
        "Text": "Thank you, brave knight. We leave at first light.",
        "EditorPosition": {
          "x": 231.923095703125,
          "y": 1819.3389892578125
        },
        "EditorSize": {
          "x": 200.76919555664063,
          "y": 109.23079681396484
        },
        "SpeakerActorId": "actor_2",
        "NextNodeId": 11,
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 9,
        "NodeType": "Dialogue",
        "Text": "I... understand. Very well. Deal.",
        "EditorPosition": {
          "x": 697.1427001953125,
          "y": 2054.287109375
        },
        "EditorSize": {
          "x": 200.0,
          "y": 100.0
        },
        "SpeakerActorId": "actor_2",
        "NextNodeId": 11,
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 10,
        "NodeType": "Dialogue",
        "Text": "Without a word, the knight turns around and walks away.",
        "EditorPosition": {
          "x": 178.84620666503906,
          "y": 1959.23095703125
        },
        "EditorSize": {
          "x": 258.46148681640625,
          "y": 93.8460693359375
        },
        "NextNodeId": 12,
        "conditionalBranch": {
          "NextNodeIdTrue": 0,
          "NextNodeIdFalse": 0
        },
        "DefaultBranchNodeId": 0
      },
      {
        "Id": 11,
        "NodeType": "Dialogue",
        "Text": "At sunrise, they depart toward the hideout where the princess was taken.",
        "EditorPosition": {
          "x": 424.28570556640625,
          "y": 2225.712890625
