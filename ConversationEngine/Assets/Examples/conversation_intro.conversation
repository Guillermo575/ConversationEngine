      },
      {
        "Id": 3,
        "NodeType": "Dialogue",
        "Text": "Many years ago, in a distant land, an old kingdom stood against the shadows.",
        "EditorPosition": {
          "x": 492.72720336914063,
          "y": 942.982421875
        },
        "EditorSize": {
          "x": 200.0,
          "y": 93.125
